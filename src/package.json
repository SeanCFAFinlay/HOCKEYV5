{
  "name": "hockey-vs-soccer-td",
  "version": "1.0.0",
  "description": "Hockey vs Soccer Tower Defense 3D Game",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "serve": "npx serve .",
    "vault": "node ../docs/vault/tools/generate-vault.mjs && node ../docs/vault/tools/generate-codebase.mjs",
    "validate:config": "node scripts/validate-configs.mjs",
    "validate": "npm run validate:config",
    "smoke": "npm run validate:config",
    "qa": "npm run validate && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
